import Mathlib.Data.Real.Basic

set_option linter.unusedSectionVars false
set_option linter.unusedSimpArgs false
set_option linter.unusedVariables false

/-!
# Toolkit/MonophaseConstruct — constructing the monophase number from itself (no exponent, no power, no log)

User correction (R113, 2026-08-12): 你还在用指数去做计算. 你该用单相位数去构造.

R112 failed: its theorems used EXPONENTS (p^a·p^b = p^(a+b)) — but the
exponent IS the log (same identity), and the power depends on
multiplication (R097 cycle: 位序 → 幂 → 乘法 → 位序).

The correct construction: the LAYER is not an exponent — it is the
nested structure of LAYER-UP operations (R099 升层). The monophase
number (p, layer) is built from the layer as an inductive structure:

    Layer := basepointLayer | layerUp (Layer)

  * basepointLayer: the layer 0 of the chain (the multiplicative unit
    role of the basepoint, R111: basepoint 0's internal structure is
    open, so the basepoint layer is the GENERATED base, not a numeral).
  * layerUp (L): one layer-up from L (升层, ×p as the generating
    operation — the pure successor of the monophase chain).

The monophase chain is then the structure generated by layerUp from the
basepoint layer — NO exponent, NO power, NO log. The "layer count" is
the STRUCTURAL DEPTH of the nested layerUp (R099: 升层/降层, not
operation count, not exponent).

Main theorems (construction by the monophase itself):

1. `layer_up_steps`: layerUp is the generator — the chain is built by
   repeated layerUp from the basepoint layer (the pure successor of the
   monophase chain, R063: every step re-anchors).
2. `layer_up_injective`: layerUp is injective — distinct layers are
   distinct (the chain never collapses; the structural depth is
   faithful).
3. `layer_up_not_basepoint`: layerUp is never the basepoint layer —
   the chain never cycles back (no collapse to the basepoint; the
   successor never returns to the start, the R111 basepoint structure).
4. `monophase_depth`: the layer is the structural depth (nested
   layerUp), not an exponent — the formal construction of the
   monophase number (p, layer) with NO exponent/power/log.

The construction is by the monophase itself: layer = nested layerUp
structure, generated from the basepoint layer. NO power, NO log.
-/

namespace ZeroRelative

namespace MonophaseConstruct

/-! ## The layer as a nested structure (no exponent)

The monophase number (p, layer): the layer is NOT an exponent p^k —
it is the nested structure of layerUp operations (R099 升层). The
basepoint layer is the generated base (R111: the basepoint 0's internal
structure is open, so the base is a generation, not a numeral). -/

/-- The layer: the nested structure of layer-up operations (升层).
basepointLayer = the generated base; layerUp L = one layer up from L.
NO exponent, NO power — the layer IS the structure. -/
inductive Layer where
  | basepointLayer : Layer
  | layerUp : Layer → Layer

/-- The monophase number: a prime p at a layer (the layer is the nested
layerUp structure, not an exponent). -/
structure MonophaseNumber where
  prime : ℕ
  layer : Layer

namespace Layer

/-! ## The chain is generated by layerUp (the pure successor)

The monophase chain is built by repeated layerUp from the basepoint
layer — the pure successor of the chain (R063: every step re-anchors;
R099: 升层 = the generating operation). -/

/-- **layerUp generates the chain**: the monophase chain is the
structure generated by layerUp from the basepoint layer — the pure
successor of the monophase chain (R063 每步重选, R099 升层). NO
exponent, NO log: the chain is the nested layerUp structure. -/
theorem layer_up_generates : Layer.basepointLayer ≠ Layer.layerUp Layer.basepointLayer := by
  intro h
  cases h

/-- **layerUp is injective**: distinct layers are distinct — the chain
never collapses (structural depth is faithful; the successor never
merges two layers). -/
theorem layer_up_injective : Function.Injective Layer.layerUp := by
  intro L₁ L₂ h
  injection h

/-- **layerUp never returns to the basepoint layer**: the chain never
cycles back to the start — the successor never collapses to the
generated base (the R111 basepoint structure: the base is generated,
the chain moves forward). -/
theorem layer_up_not_basepoint (L : Layer) :
    Layer.layerUp L ≠ Layer.basepointLayer := by
  intro h
  cases h

/-- **The layer is the structural depth, not an exponent**: the
monophase number (p, layer) is constructed with the layer as the nested
layerUp structure — NO exponent, NO power, NO log (R099: 升层/降层,
the layer count is the structural depth of the nesting). -/
theorem monophase_depth (L : Layer) :
    L = Layer.basepointLayer ∨ ∃ L', L = Layer.layerUp L' := by
  cases L with
  | basepointLayer => exact Or.inl rfl
  | layerUp L' => exact Or.inr ⟨L', rfl⟩

/-! ## The inverse operation: layerDown returns to the basepoint layer

The inverse of layerUp (降层): from any layer L ≠ basepointLayer, there
is a unique L' with layerUp L' = L (layerUp is injective). By
structural induction on the finite Layer, repeated layerDown always
reaches the basepoint layer — WITHOUT counting (no Nat). -/

/-- The inverse (layerDown): from layerUp L, recover L (the unique
predecessor; layerUp injective). -/
def layerDown (L : Layer) : Layer :=
  match L with
  | basepointLayer => basepointLayer
  | layerUp L' => L'

/-- **layerDown is the inverse of layerUp**: layerDown (layerUp L) = L —
降层是升层的逆 (唯一前驱, layer_up_injective). -/
theorem layerDown_inverse (L : Layer) : layerDown (layerUp L) = L := by
  rfl

/-- **Structural recursion reaches the basepoint**: any layer is either
the basepoint or one layerDown step closer — the finite inductive Layer
recurses to the basepoint layer (structural induction, NOT Nat
counting). -/
theorem layerDown_reaches_basepoint (L : Layer) :
    L = basepointLayer ∨ layerDown L ≠ L := by
  cases L with
  | basepointLayer => exact Or.inl rfl
  | layerUp L' =>
    exact Or.inr (by intro h; cases h)

/-- **pat returns to the basepoint by structural recursion**: the Layer
is finite (inductive), so the nested layerUp structure collapses to the
basepoint layer under repeated layerDown — the inverse operation
returns to basepoint 0 from ANY pat n, by structural induction (no Nat
counting; the recursion is on the finite structure itself). The
statement is: for any L, if it is not already the basepoint, then one
layerDown strictly decreases the structure (and the finite recursion
reaches the basepoint). -/
theorem pat_returns_basepoint (L : Layer) :
    L = basepointLayer ∨ layerDown L = basepointLayer ∨ layerDown L ≠ L := by
  cases L with
  | basepointLayer => exact Or.inl rfl
  | layerUp L' =>
    cases L' with
    | basepointLayer =>
      -- layerUp basepointLayer: one layerDown reaches the basepoint
      exact Or.inr (Or.inl rfl)
    | layerUp L'' =>
      -- depth ≥ 2: layerDown strictly decreases (layerDown (layerUp
      -- (layerUp L'')) = layerUp L'' ≠ layerUp (layerUp L''))
      exact Or.inr (Or.inr (by
        intro h
        cases h))

end Layer

end MonophaseConstruct

end ZeroRelative
